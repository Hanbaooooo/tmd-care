/* 报告页：全页无卡片，靠细线与留白分组，与全站一致 */

.mt8 {
  margin-top: 8rpx;
}
.mt16 {
  margin-top: 16rpx;
}
.mt24 {
  margin-top: 24rpx;
}
.mb12 {
  margin-bottom: 12rpx;
}
.small {
  font-size: 28rpx;
  color: var(--ink-2);
  letter-spacing: 1rpx;
}
.intro {
  margin: 10rpx 0 34rpx;
}
.foot-space {
  height: 72rpx;
}

/* ---------- 主状态 ---------- */
.state {
  padding: 22rpx 0 22rpx 24rpx;
  border-left: 3rpx solid var(--moss-soft);
  margin-top: 8rpx;
}

.state-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.state-label {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--moss);
}

.state-rule {
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 0.6rpx;
}

.state-action {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.state-priority {
  border-left-color: var(--alert);
}
.state-priority .state-label {
  color: var(--alert);
}

.state-need_more {
  border-left-color: #9A7B4F;
}
.state-need_more .state-label {
  color: #8A6C42;
}

.state-pending_input {
  border-left-color: var(--note);
}
.state-pending_input .state-label {
  color: var(--note);
}

/* ---------- 键值行 ---------- */
.kv {
  margin-top: 10rpx;
}

.kv-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.kv-row:last-child {
  border-bottom: none;
}

.k {
  font-size: 26rpx;
  color: var(--ink-3);
}

.v {
  font-size: 27rpx;
  color: var(--ink);
  max-width: 62%;
  text-align: right;
}

/* ---------- 完成度 ---------- */
.prog {
  margin-top: 22rpx;
}

.prog-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.prog-label {
  font-size: 25rpx;
  color: var(--ink-2);
}

.prog-num {
  font-size: 27rpx;
  color: var(--moss);
}

.prog-track {
  height: 6rpx;
  background: var(--paper-2);
  border-radius: 4rpx;
  overflow: hidden;
}

.prog-fill {
  height: 6rpx;
  background: var(--moss);
  border-radius: 4rpx;
  transition: width 260ms cubic-bezier(0.32, 0.72, 0, 1);
}

/* ---------- Axis I ---------- */
.ax1 {
  margin-top: 10rpx;
}

.ax1-line {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.ax1-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin: 13rpx 16rpx 0 0;
  flex: 0 0 auto;
  background: var(--moss-soft);
}

.ax1-dot.alert {
  background: var(--alert);
}

.ax1-dot.caution {
  background: #9A7B4F;
}

.ax1-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.62;
  color: var(--ink-2);
}

.ax1-note {
  margin-top: 16rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid var(--line);
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

/* ---------- Axis II ---------- */
.ax2 {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.ax2:last-child {
  border-bottom: none;
}

.ax2-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.ax2-name {
  font-size: 27rpx;
  color: var(--ink);
}

.ax2-score {
  font-size: 26rpx;
  color: var(--ink-2);
}

.ax2-bar {
  height: 4rpx;
  background: var(--paper-2);
  border-radius: 3rpx;
  margin: 12rpx 0 10rpx;
  overflow: hidden;
}

.ax2-fill {
  height: 4rpx;
  border-radius: 3rpx;
  background: var(--moss-soft);
  transition: width 300ms cubic-bezier(0.32, 0.72, 0, 1);
}

.ax2-fill.caution {
  background: #C0A170;
}

.ax2-fill.alert {
  background: #B87F72;
}

.ax2-band {
  font-size: 23rpx;
  color: var(--ink-3);
}

.ax2-band.caution {
  color: #8A6C42;
}

.ax2-band.alert {
  color: var(--alert);
}

/* ---------- 判定依据 ---------- */
.hit {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.hit:last-child {
  border-bottom: none;
}

.hit-top {
  display: flex;
  align-items: center;
}

.hit-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex: 0 0 auto;
  background: var(--moss-soft);
}

.hit-dot.alert {
  background: var(--alert);
}

.hit-dot.caution {
  background: #9A7B4F;
}

.hit-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.hit-arrow {
  font-size: 30rpx;
  color: var(--ink-3);
  padding-left: 16rpx;
}

.hit-detail {
  margin-top: 8rpx;
  padding-left: 22rpx;
  font-size: 25rpx;
  line-height: 1.68;
  color: var(--ink-2);
}

.hit-basis {
  margin: 14rpx 0 4rpx 22rpx;
  padding: 16rpx 18rpx;
  background: rgba(255, 255, 255, 0.34);
  border-radius: 12rpx;
}

.basis-row {
  display: flex;
  align-items: flex-start;
  padding: 5rpx 0;
}

.basis-k {
  width: 78rpx;
  flex: 0 0 auto;
  font-size: 22rpx;
  color: var(--ink-3);
}

.basis-v {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-2);
  word-break: break-all;
}

/* ---------- 医师意见 ---------- */
.doc-act {
  font-size: 28rpx;
  color: var(--moss);
  margin: 12rpx 0 14rpx;
}

.doc-note {
  font-size: 27rpx;
  line-height: 1.72;
  color: var(--ink-2);
  padding-left: 22rpx;
  border-left: 2rpx solid var(--line);
}

.sign-line {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  letter-spacing: 0.4rpx;
}

/* ---------- 免责 ---------- */
.disclaimer {
  margin-top: 56rpx;
  padding: 22rpx 0 0;
  border-top: 1rpx solid var(--line-soft);
  font-size: 23rpx;
  line-height: 1.72;
  color: var(--ink-3);
}

.strong {
  color: var(--ink-2);
}
