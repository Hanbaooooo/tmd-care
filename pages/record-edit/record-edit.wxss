.intro {
  margin: 16rpx 0 32rpx;
}

.mt6 {
  margin-top: 6rpx;
}

.mt24 {
  margin-top: 24rpx;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx 26rpx;
}

.field-label {
  font-size: 29rpx;
  color: var(--ink);
}

.picker {
  font-size: 29rpx;
  color: var(--moss);
}

.block {
  margin-top: 36rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.big-value {
  font-size: 88rpx;
  font-weight: 600;
  color: var(--moss);
  text-align: center;
  line-height: 1.2;
  margin: 16rpx 0 8rpx;
}

.scale-ends {
  display: flex;
  justify-content: space-between;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 14rpx 24rpx;
  background: transparent;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  font-size: 27rpx;
  color: var(--ink);
}

.chip.on {
  background: var(--sage-bg);
  border: 2rpx solid var(--moss);
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  background: transparent;
  border: 1rpx solid var(--line-soft);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
  margin-top: 12rpx;
  box-sizing: border-box;
}
