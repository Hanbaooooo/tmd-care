<bg-layer />
<view class="page tab-page">
  <nav-bar />
  <view class="head rise">
    <view class="h1">就诊与帮助</view>
    <view class="lede">去医院之前把话说清楚，比坐在诊室里回想省事。</view>
  </view>

  <!-- 主任务：靠阴影浮起，不用色条 -->
  <view class="primary-task rise-1" bindtap="startTriage" hover-class="pressed">
    <view class="primary-task-label">就诊准备</view>
    <view class="primary-task-title">把现在的症状整理成一页纸</view>
    <view class="pt-body">先确认几件要紧的事，再答 6 个问题。整理好直接给医生看。</view>
    <view class="pt-foot">
      <text class="pt-time">约 3 分钟</text>
      <text class="pt-go">开始整理 ›</text>
    </view>
  </view>

  <view wx:if="{{hasSummary}}" class="entry-line mt16 rise-2" bindtap="openSummary" hover-class="pressed">
    <view>
      <view class="entry-title">上次整理的那份</view>
      <view class="tiny">{{summaryDate}}</view>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <!-- 就医指征：分两级，不给患者一张八条清单 -->
  <view class="section rise-2">
    <view class="h2 small">这些情况要尽快处理</view>

    <view class="group" wx:for="{{whenToSee}}" wx:key="key">
      <view class="group-head">
        <text class="group-title {{item.key}}">{{item.title}}</text>
        <text class="group-hint">{{item.hint}}</text>
      </view>
      <view class="li" wx:for="{{item.items}}" wx:for-item="line" wx:key="*this">
        <view class="li-dot {{item.key}}"></view>
        <text class="li-text">{{line}}</text>
      </view>
    </view>

    <view class="note-danger mt20">
      <text class="note-lead">三件事同时出现，别等回复</text>
      明显肿胀、发热、张口后闭不上同时出现，直接去口腔急诊。
    </view>
  </view>

  <view class="section rise-3">
    <view class="h2 small">还想问点什么</view>
    <view class="entry-line" bindtap="goAnxin" hover-class="pressed">
      <view>
        <view class="entry-title">安心</view>
        <view class="tiny">问一句，回答只来自审核过的内容</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry-line" bindtap="goPlan" hover-class="pressed">
      <view>
        <view class="entry-title">六周计划</view>
        <view class="tiny">从自我管理开始，不必先弄清全部医学名词</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{hasResearch}}" class="section rise-3">
    <view class="h2 small">研究</view>
    <view class="entry-line" bindtap="goResearch" hover-class="pressed">
      <view>
        <view class="entry-title">我的研究任务</view>
        <view class="tiny">哪天该来、还有什么没填</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <view class="section rise-4">
    <view class="h2 small">关于你的数据</view>
    <view class="card-sunk">
      <view class="para">账号里只存你自己记下的症状、课程和就诊资料。</view>
      <view class="para">参加研究要单独同意。平时记的东西，不会事后被拿去当研究数据。</view>
      <view class="para last">研究编号和你的联系方式分开存。研究人员只能看到你授权的那部分。</view>
      <view wx:if="{{signedIn}}" class="btn-text mt16" bindtap="logout">退出登录</view>
      <view wx:else class="btn-text mt16" bindtap="goLogin">登录后同步到账户 ›</view>
    </view>
  </view>
  <view class="tab-fade"></view>
</view>
