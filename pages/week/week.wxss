.week-head {
  padding: 16rpx 0 24rpx;
}

.mt8 {
  margin-top: 8rpx;
}

.mt10 {
  margin-top: 10rpx;
}

.mt12 {
  margin-top: 12rpx;
}

.ml {
  margin-left: 12rpx;
}

.block {
  margin-top: 40rpx;
}

.block-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.step-no {
  width: 44rpx;
  line-height: 1;
  text-align: left;
  border-radius: 0;
  background: transparent;
  color: var(--ink-3);
  font-size: 21rpx;
  letter-spacing: 1rpx;
  margin-right: 14rpx;
}

.step-no.done {
  background: transparent;
  color: var(--moss);
}

.block-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.point {
  font-size: 29rpx;
  line-height: 1.75;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.step-line {
  display: flex;
  margin-bottom: 16rpx;
}

.step-index {
  width: 40rpx;
  color: var(--moss);
  font-size: 26rpx;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.7;
  color: var(--ink);
}

.tip-line {
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background: transparent;
  border: 1rpx solid var(--line-soft);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--ink);
  margin-top: 12rpx;
  box-sizing: border-box;
}

.nav-row {
  display: flex;
  gap: 20rpx;
  margin-top: 48rpx;
}

.flex1 {
  flex: 1;
}

.is-hidden {
  visibility: hidden;
}
