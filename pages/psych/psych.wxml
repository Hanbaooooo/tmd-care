<bg-layer />
<view class="page">
  <nav-bar back="{{true}}" />

  <block wx:if="{{!result}}">
    <view class="rail">
      <view class="rail-fill" style="width:{{percent}}%"></view>
    </view>

    <view class="eyebrow">{{idx + 1}} / {{total}} · 心理与行为</view>

    <view class="sec-head">
      <view class="sec-name">{{section.name}}</view>
      <view class="sec-sub">{{section.sub}}</view>
    </view>

    <view class="sec-instruct">{{section.instruct}}</view>
    <view class="legend">{{section.legend}}</view>

    <view class="q {{q.miss ? 'is-miss' : ''}}" id="item-{{q.key}}" wx:for="{{section.questions}}" wx:key="key" wx:for-item="q">
      <view class="q-head">
        <text class="q-no num">{{q.no}}</text>
        <view class="q-title">{{q.text}}</view>
      </view>

      <view class="opts {{q.type}}">
        <view
          class="opt {{o.checked ? 'on' : ''}}"
          wx:for="{{q.options}}"
          wx:key="value"
          wx:for-item="o"
          data-q="{{q.key}}"
          data-v="{{o.value}}"
          bindtap="pick"
          hover-class="opt-press"
          hover-stay-time="60"
        >
          {{o.label}}
        </view>
      </view>
    </view>

    <view class="foot-space"></view>

    <view class="footer">
      <view class="foot-btn back" bindtap="prev" hover-class="is-fade" hover-stay-time="80">
        {{idx === 0 ? '退出' : '上一部分'}}
      </view>
      <view
        class="btn-primary foot-btn grow {{canNext ? '' : 'is-disabled'}}"
        bindtap="next"
        hover-class="is-active"
        hover-stay-time="80"
      >
        {{idx === total - 1 ? '看结果' : '下一部分'}}
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="eyebrow">{{fromHistory ? '心理与行为 · 上次结果' : '心理与行为 · 结果'}}</view>
    <view class="h1">{{fromHistory ? '上一次的分数' : '四份问卷的结果'}}</view>
    <view wx:if="{{fromHistory}}" class="muted result-lede">{{historyLine}}</view>
    <view wx:else class="muted result-lede">
      这是这一次的分数，过一阵再测一次，对比着看。它不能当诊断，也不会换算成关节的毛病。
    </view>

    <view class="score" wx:for="{{result.scores}}" wx:key="key" wx:for-item="s">
      <view class="score-head">
        <text class="score-label">{{s.label}}</text>
        <text class="score-num num">{{s.value}}<text class="score-max">/{{s.max}}</text></text>
      </view>
      <view class="bar">
        <view class="bar-fill {{s.tone}}" style="width:{{s.percent}}%"></view>
      </view>
      <view class="score-band {{s.tone}}">{{s.band}}</view>
      <view class="score-text">{{s.text}}</view>
    </view>

    <view wx:if="{{result.notes.length}}" class="note-info mt24">
      <view class="note-line" wx:for="{{result.notes}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="boundary mt24">
      <view class="boundary-strong">这几个分数，说的是过去这段时间的你</view>
      <view class="boundary-text">
        GAD-7 和 PHQ-4 只是初筛，不是诊断；OBC 和 JFLS-8 记的是习惯和活动能力，不代表病有多重。
      </view>
    </view>

    <!-- 收尾：一句话结论 + 一段画像，放在最后 -->
    <view class="portrait {{result.portrait.tone}}" wx:if="{{result.portrait}}">
      <view class="portrait-eyebrow">总的来说</view>
      <view class="portrait-conclusion">{{result.portrait.conclusion}}</view>
      <view class="portrait-title">{{result.portrait.title}}</view>
      <view class="portrait-text">{{result.portrait.text}}</view>
      <view class="portrait-act">
        <text class="portrait-act-k">先做这一件</text>
        <text class="portrait-act-v">{{result.portrait.act}}</text>
      </view>
      <view class="btn-ghost mt24" bindtap="goReport" hover-class="is-active" hover-stay-time="80">
        看这次的双轴报告 ›
      </view>
    </view>

    <view class="foot-space"></view>

    <view class="footer">
      <view class="foot-btn back" bindtap="again" hover-class="is-fade" hover-stay-time="80">再测一次</view>
      <view class="btn-primary foot-btn grow" bindtap="goHome" hover-class="is-active" hover-stay-time="80">
        回到首页
      </view>
    </view>
  </block>
</view>
