.intro {
  margin: 16rpx 0 32rpx;
}

.mt10 {
  margin-top: 10rpx;
}

.mt12 {
  margin-top: 12rpx;
}

.mt24 {
  margin-top: 24rpx;
}

.summary-card {
  background: transparent;
  border: none;
  border-top: 1rpx solid var(--line-soft);
  border-bottom: 1rpx solid var(--line-soft);
  border-radius: 0;
  padding: 26rpx 0;
}

.task-cta {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--moss);
}

.small {
  font-size: 30rpx;
}

.week-row {
  display: flex;
  align-items: center;
  background: transparent;
  border: none;
  border-bottom: 1rpx solid var(--line-soft);
  border-radius: 0;
  padding: 26rpx 0;
  margin-top: 0;
}

.week-row.is-current {
  background: transparent;
  border-bottom: 1rpx solid var(--moss);
}

.week-no {
  width: 56rpx;
  line-height: 1;
  text-align: left;
  border-radius: 0;
  background: transparent;
  color: var(--ink-3);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.week-row.is-current .week-no {
  background: var(--moss);
  color: #F3F7F4;
}

.week-main {
  flex: 1;
}

.week-title {
  font-size: 29rpx;
  color: var(--ink);
  line-height: 1.5;
}

.week-marks {
  margin-top: 8rpx;
}

.mark {
  font-size: 22rpx;
  color: #B0BCB7;
  margin-right: 16rpx;
}

.mark.on {
  color: var(--moss);
}

.week-arrow {
  font-size: 36rpx;
  color: var(--sage);
}
