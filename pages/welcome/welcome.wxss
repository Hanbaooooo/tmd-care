.wrap {
  position: relative;
  z-index: 1; /* 压在 bg-layer 之上 */
  min-height: 100vh;
  padding: 104rpx 44rpx 48rpx;
  padding-top: calc(104rpx + env(safe-area-inset-top));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 右上角一团极淡的光，7s 呼吸——全页唯一循环动效 */
.halo {
  position: absolute;
  top: -180rpx;
  right: -200rpx;
  width: 620rpx;
  height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(186, 210, 194, 0.42) 0%, rgba(186, 210, 194, 0) 68%);
  animation: halo 7s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  pointer-events: none;
}

@keyframes halo {
  0%, 100% { transform: scale(1); opacity: 0.72; }
  50% { transform: scale(1.08); opacity: 1; }
}

/* ---------- 标识 ---------- */
.mark {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.mark-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--sage-bg);
  color: var(--moss);
  font-size: 30rpx;
  line-height: 64rpx;
  text-align: center;
  letter-spacing: 0;
}

.mark-text {
  display: flex;
  flex-direction: column;
}

.mark-name {
  font-size: 27rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}

.mark-en {
  font-size: 17rpx;
  color: var(--ink-3);
  letter-spacing: 2.6rpx;
  margin-top: 2rpx;
}

/* ---------- 标题区 ---------- */
.eyebrow {
  margin-top: 72rpx;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

.title {
  font-size: 56rpx;
  line-height: 1.3;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.title-first {
  margin-top: 18rpx;
}

.lede {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink-2);
}

/* 一行节奏条，替代三张并列卡片 */
.rhythm {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rhythm-item {
  font-size: 21rpx;
  letter-spacing: 0.6rpx;
  color: var(--ink-3);
}

.rhythm-sep {
  font-size: 19rpx;
  color: var(--line);
}

/* ---------- 登录区：不做面板，只用一条细线接住 ---------- */
.panel {
  position: relative;
  margin-top: 60rpx;
  padding-top: 34rpx;
  border-top: 1rpx solid var(--line-soft);
}

.panel-head {
  font-size: 24rpx;
  color: var(--ink-2);
  letter-spacing: 2rpx;
}

.panel-note {
  margin: 14rpx 0 34rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--ink-3);
}

.pending {
  color: var(--note);
  font-size: 23rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

/* 面板内次要动作靠间距分层，不加边框 */
.alt {
  text-align: center;
  padding: 24rpx 0 2rpx;
  font-size: 25rpx;
  color: var(--ink-2);
}

.alt:active {
  opacity: 0.6;
}

.field-label {
  font-size: 23rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  margin: 8rpx 0 12rpx;
}

.field {
  height: 88rpx;
  padding: 0;
  margin-bottom: 26rpx;
  background: transparent;
  border-bottom: 1rpx solid var(--line);
  border-radius: 0;
  font-size: 29rpx;
  color: var(--ink);
}

.sent {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-bottom: 16rpx;
}

.error {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--alert);
}

/* ---------- 跳过 ---------- */
.later {
  margin-top: 34rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--ink-2);
  padding: 16rpx;
}

.later-arrow {
  margin-left: 10rpx;
  color: var(--ink-3);
}

.is-fade {
  opacity: 0.55;
}

/* ---------- 页脚 ---------- */
.foot {
  margin-top: auto;
  padding-top: 72rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.preparing {
  margin-top: 64rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  animation: fadein 300ms ease both;
}

@keyframes fadein {
  from { opacity: 0; }
  to { opacity: 1; }
}
