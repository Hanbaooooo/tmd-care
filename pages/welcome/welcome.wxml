<bg-layer />
<view class="wrap">
  <!-- 极淡的呼吸光，全页唯一动效 -->
  <view class="halo"></view>

  <view class="top">
    <view class="mark">
      <view class="mark-badge">颌</view>
      <view class="mark-text">
        <text class="mark-name">颌·心</text>
        <text class="mark-en">DC/TMD DUAL-AXIS</text>
      </view>
    </view>

    <view class="eyebrow">下颌不适 · 就诊前评估</view>
    <view class="title title-first">候诊这几分钟</view>
    <view class="title">把症状说清楚</view>
    <view class="lede">不用先懂医学名词，按实际情况答就行。答案会整理成一页，医师面诊时看。</view>

    <view class="rhythm">
      <text class="rhythm-item">01 说症状</text>
      <text class="rhythm-sep">/</text>
      <text class="rhythm-item">02 双轴评估</text>
      <text class="rhythm-sep">/</text>
      <text class="rhythm-item">03 医师签核</text>
    </view>
  </view>

  <block wx:if="{{ready}}">
    <view class="panel">
      <view class="panel-head">开始这次评估</view>
      <view class="panel-note">
        登录后，这次的填写才能和你的就诊记录对上，医师在诊室里打开就看得到。不登录也能填，但只存在这台手机上。
      </view>

      <view wx:if="{{pendingText}}" class="pending">{{pendingText}}</view>

      <view
        wx:if="{{wechatAvailable}}"
        class="btn-primary {{wechatBusy ? 'is-disabled' : ''}}"
        bindtap="onWechat"
        hover-class="is-active"
        hover-stay-time="80"
      >{{wechatBusy ? '正在登录…' : '微信一键登录'}}</view>

      <view
        wx:else
        class="btn-primary"
        bindtap="toggleEmail"
        hover-class="is-active"
        hover-stay-time="80"
      >用邮箱验证码登录</view>

      <view wx:if="{{wechatAvailable && !emailOpen}}" class="alt" bindtap="toggleEmail">
        改用邮箱验证码
      </view>

      <!-- 邮箱登录 -->
      <block wx:if="{{emailOpen}}">
        <view class="field-label">邮箱</view>
        <block wx:if="{{step === 'start'}}">
          <input
            class="field"
            type="text"
            placeholder="用于接收验证码"
            value="{{email}}"
            bindinput="onEmailInput"
            confirm-type="done"
          />
          <view
            class="btn-primary {{sending ? 'is-disabled' : ''}}"
            bindtap="onSendCode"
            hover-class="is-active"
            hover-stay-time="80"
          >{{sending ? '正在发送…' : '获取验证码'}}</view>
        </block>

        <block wx:else>
          <view class="sent">{{email}}</view>
          <input
            class="field"
            type="number"
            placeholder="输入验证码"
            value="{{code}}"
            bindinput="onCodeInput"
            maxlength="8"
          />
          <view
            class="btn-primary {{verifying ? 'is-disabled' : ''}}"
            bindtap="onVerify"
            hover-class="is-active"
            hover-stay-time="80"
          >{{verifying ? '正在验证…' : '登录'}}</view>
          <view class="alt" bindtap="onBackEmail">换一个邮箱</view>
        </block>
      </block>

      <view wx:if="{{error}}" class="error">{{error}}</view>
    </view>

    <view class="later" bindtap="skip" hover-class="is-fade" hover-stay-time="80">
      先不登录，直接进入
      <text class="later-arrow">›</text>
    </view>
  </block>

  <view wx:else class="preparing">正在准备…</view>

  <view class="foot">
    <view>只做评估与就诊参考，不替代医师诊断。</view>
    <view>报告上的优先级只表示医师复核的先后，不代表患病概率。</view>
    <view>患者看到的内容，以医师签核定稿为准。</view>
  </view>
</view>
