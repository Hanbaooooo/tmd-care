<bg-layer />
<view class="wrap">
  <!-- 极淡的呼吸光，全页唯一动效 -->
  <view class="halo"></view>

  <view class="top">
    <view class="mark">
      <view class="mark-badge">颞</view>
      <view class="mark-text">
        <text class="mark-name">颞安智护</text>
        <text class="mark-en">TMD SELF-MANAGEMENT</text>
      </view>
    </view>

    <view class="eyebrow">下颌不适 · 自我管理</view>
    <view class="title title-first">先弄清楚</view>
    <view class="title">现在该做什么</view>
    <view class="lede">不用先懂医学名词，也不用自己判断严不严重。</view>

    <view class="rhythm">
      <text class="rhythm-item">01 说感受</text>
      <text class="rhythm-sep">/</text>
      <text class="rhythm-item">02 看结果</text>
      <text class="rhythm-sep">/</text>
      <text class="rhythm-item">03 做一件事</text>
    </view>
  </view>

  <block wx:if="{{ready}}">
    <view class="panel">
      <view class="panel-head">继续使用</view>
      <view class="panel-note">
        记录默认存在这台手机上。登录就为两件事：换手机别丢，研究回访时对上你的编号。
      </view>

      <view wx:if="{{pendingText}}" class="pending">{{pendingText}}</view>

      <view
        wx:if="{{wechatAvailable}}"
        class="btn-primary {{wechatBusy ? 'is-disabled' : ''}}"
        bindtap="onWechat"
        hover-class="is-active"
        hover-stay-time="80"
      >{{wechatBusy ? '正在登录…' : '微信一键登录'}}</view>

      <view
        wx:else
        class="btn-primary"
        bindtap="toggleEmail"
        hover-class="is-active"
        hover-stay-time="80"
      >用邮箱验证码登录</view>

      <view wx:if="{{wechatAvailable && !emailOpen}}" class="alt" bindtap="toggleEmail">
        改用邮箱验证码
      </view>

      <!-- 邮箱登录 -->
      <block wx:if="{{emailOpen}}">
        <view class="field-label">邮箱</view>
        <block wx:if="{{step === 'start'}}">
          <input
            class="field"
            type="text"
            placeholder="用于接收验证码"
            value="{{email}}"
            bindinput="onEmailInput"
            confirm-type="done"
          />
          <view
            class="btn-primary {{sending ? 'is-disabled' : ''}}"
            bindtap="onSendCode"
            hover-class="is-active"
            hover-stay-time="80"
          >{{sending ? '正在发送…' : '获取验证码'}}</view>
        </block>

        <block wx:else>
          <view class="sent">{{email}}</view>
          <input
            class="field"
            type="number"
            placeholder="输入验证码"
            value="{{code}}"
            bindinput="onCodeInput"
            maxlength="8"
          />
          <view
            class="btn-primary {{verifying ? 'is-disabled' : ''}}"
            bindtap="onVerify"
            hover-class="is-active"
            hover-stay-time="80"
          >{{verifying ? '正在验证…' : '登录'}}</view>
          <view class="alt" bindtap="onBackEmail">换一个邮箱</view>
        </block>
      </block>

      <view wx:if="{{error}}" class="error">{{error}}</view>
    </view>

    <view class="later" bindtap="skip" hover-class="is-fade" hover-stay-time="80">
      先不登录，直接进入
      <text class="later-arrow">›</text>
    </view>
  </block>

  <view wx:else class="preparing">正在准备…</view>

  <view class="foot">
    用于健康筛查、自我管理与研究回访，不替代医生诊断。
  </view>
</view>
