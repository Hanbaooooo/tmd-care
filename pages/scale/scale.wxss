.intro {
  margin: 16rpx 0 24rpx;
}

.mt8 {
  margin-top: 8rpx;
}

.mt16 {
  margin-top: 16rpx;
}

.mt24 {
  margin-top: 24rpx;
}

.mb {
  margin-bottom: 24rpx;
}

.q-block {
  margin-top: 32rpx;
}

/* 漏答被点出来时，只给一条竖线，不弹窗 */
.q-block.is-miss {
  margin: 32rpx -14rpx 0;
  padding: 16rpx 14rpx 8rpx;
  background: rgba(154, 112, 62, 0.06);
  box-shadow: inset 3rpx 0 0 var(--note);
}

.q-title {
  font-size: 29rpx;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 题目自带锚点说明时，先给一句极轻的提示，再列选项 */
.q-hint {
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  margin: -10rpx 0 14rpx;
}

.flex1 {
  flex: 1;
}

.big-value {
  font-size: 96rpx;
  font-weight: 600;
  color: var(--moss);
  text-align: center;
  line-height: 1.2;
  margin: 24rpx 0 8rpx;
}

.scale-ends {
  display: flex;
  justify-content: space-between;
}

.grid-value {
  font-size: 30rpx;
  color: var(--moss);
  font-weight: 600;
  min-width: 60rpx;
  text-align: right;
}

.small {
  font-size: 28rpx;
}

.score {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--moss);
}
