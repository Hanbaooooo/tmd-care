/* 工作台：列表用细线分隔的行，不做卡片堆叠 */

.mt12 {
  margin-top: 12rpx;
}
.intro {
  margin: 10rpx 0 26rpx;
}
.foot-space {
  height: 72rpx;
}

/* 范围说明：把边界讲在明面上，不做隐性承诺 */
.mode-note {
  padding: 18rpx 20rpx;
  background: rgba(255, 255, 255, 0.34);
  border-radius: 12rpx;
  margin-bottom: 28rpx;
}

.mode-k {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  margin-bottom: 6rpx;
}

.mode-v {
  font-size: 23rpx;
  line-height: 1.68;
  color: var(--ink-2);
}

/* 筛选 */
.tabs {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.tab {
  padding: 16rpx 0;
  margin-right: 44rpx;
  font-size: 27rpx;
  color: var(--ink-3);
  position: relative;
}

.tab.on {
  color: var(--moss);
}

.tab.on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
  height: 2rpx;
  background: var(--moss);
}

.tab-num {
  font-size: 21rpx;
  margin-left: 8rpx;
  color: var(--ink-3);
}

.tab.on .tab-num {
  color: var(--moss);
}

/* 队列行 */
.q-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.q-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.q-no {
  font-size: 28rpx;
  color: var(--ink);
  letter-spacing: 0.6rpx;
}

.q-badge {
  font-size: 21rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  color: var(--moss);
  background: var(--sage-bg);
}

.q-badge.alert {
  color: var(--alert);
  background: var(--alert-bg);
}

.q-badge.caution {
  color: #8A6C42;
  background: rgba(192, 161, 112, 0.18);
}

.q-badge.note {
  color: var(--note);
  background: var(--note-bg);
}

.q-mid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.q-hits {
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.6;
  flex: 1;
}

.q-arrow {
  font-size: 30rpx;
  color: var(--ink-3);
  padding-left: 16rpx;
}

.q-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.q-time {
  font-size: 22rpx;
  color: var(--ink-3);
}

.q-signed {
  font-size: 22rpx;
  color: var(--moss);
}
