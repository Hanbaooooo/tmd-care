/* 临床工作台：医师端信息密度高，用浅色卡片分块；
   患者端仍是留白+细线的阅读版式，两边只在色板上共用。 */

.mt8 {
  margin-top: 8rpx;
}
.foot-space {
  height: 96rpx;
}

/* ---------- 身份条 ---------- */
.wb-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 26rpx;
}

.wb-brand {
  display: flex;
  align-items: center;
  min-width: 0;
}

.wb-logo {
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  background: var(--moss);
  color: #F3F7F4;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(56, 97, 79, 0.22);
}

.wb-name {
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: var(--ink);
}

.wb-sub {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
  letter-spacing: 0.4rpx;
}

.wb-id {
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 22rpx;
  font-size: 21rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

/* ---------- KPI ---------- */
.kpi {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.kpi-cell {
  width: 48.4%;
  padding: 20rpx 22rpx 18rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.66);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 8rpx 24rpx rgba(30, 47, 41, 0.045);
}

.kpi-k {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.4rpx;
  margin-bottom: 6rpx;
}

.kpi-v {
  font-size: 46rpx;
  line-height: 1.2;
  color: var(--moss);
  letter-spacing: 0.5rpx;
}

.kpi-unit {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-left: 6rpx;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

/* ---------- 面板 ---------- */
.panel {
  margin-top: 16rpx;
  padding: 26rpx 24rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.66);
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  box-shadow: 0 8rpx 26rpx rgba(30, 47, 41, 0.045);
}

.panel-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.panel-t {
  font-size: 29rpx;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.6rpx;
}

.panel-x {
  font-size: 21rpx;
  color: var(--ink-3);
}

.panel-empty {
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-3);
  padding: 14rpx 0 8rpx;
}

/* ---------- 今日漏斗 ---------- */
.flow {
  display: flex;
  padding: 6rpx 0 2rpx;
}

.flow-i {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

/* 连接线画在两个圆点之间：线的中线要压在圆点圆心上 */
.flow-i::before,
.flow-i::after {
  content: '';
  position: absolute;
  top: 50rpx;
  height: 2rpx;
  background: var(--line);
  z-index: 0;
}

.flow-i::before {
  left: 0;
  right: 50%;
}

.flow-i::after {
  left: 50%;
  right: 0;
}

.flow-i:first-child::before,
.flow-i:last-child::after {
  display: none;
}

.flow-l {
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--ink-3);
  margin-bottom: 14rpx;
  white-space: nowrap;
}

.flow-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid var(--sage);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.flow-dot.done {
  background: var(--moss);
  border-color: var(--moss);
}

.flow-dot.active {
  border-color: var(--moss);
  box-shadow: 0 0 0 6rpx rgba(56, 97, 79, 0.09);
}

.flow-tick {
  font-size: 15rpx;
  line-height: 1;
  color: #FFFFFF;
}

.flow-n {
  font-size: 27rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
}

.flow-n.on {
  color: var(--ink);
}

/* ---------- 筛选 chips ---------- */
.chips-wrap {
  width: 100%;
  margin-bottom: 6rpx;
}

.chips {
  display: flex;
  align-items: center;
  padding: 2rpx 0 4rpx;
}

.chip {
  flex: none;
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  margin-right: 14rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid var(--line-soft);
}

.chip.on {
  color: #F3F7F4;
  background: var(--moss);
  border-color: var(--moss);
}

.chip-press {
  opacity: 0.7;
}

.chip-n {
  font-size: 21rpx;
  margin-left: 8rpx;
  color: var(--ink-3);
}

.chip.on .chip-n {
  color: rgba(243, 247, 244, 0.8);
}

/* ---------- 队列卡片 ---------- */
.queue {
  margin-top: 10rpx;
}

.q-card {
  padding: 22rpx 20rpx 18rpx;
  margin-top: 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--line-soft);
}

.q-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.q-no {
  font-size: 30rpx;
  color: var(--ink);
  letter-spacing: 0.8rpx;
}

.q-badge {
  flex: none;
  font-size: 21rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  color: var(--moss);
  background: var(--sage-bg);
}

.q-badge.alert {
  color: var(--alert);
  background: var(--alert-bg);
}

.q-badge.caution {
  color: #8A6C42;
  background: rgba(192, 161, 112, 0.18);
}

.q-badge.note {
  color: var(--note);
  background: var(--note-bg);
}

.q-meta {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.q-sep {
  margin: 0 8rpx;
}

/* 进度：条 + 数字，条只做长度，不做颜色分级 */
.q-prog {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.bar {
  flex: 1;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(30, 47, 41, 0.07);
  overflow: hidden;
}

.bar-in {
  height: 100%;
  border-radius: 8rpx;
  background: var(--moss);
  transition: width 420ms cubic-bezier(0.32, 0.72, 0, 1);
}

.bar-in.low {
  background: var(--moss-soft);
}

.q-pct {
  flex: none;
  width: 78rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-2);
}

.q-hint {
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.6;
  margin-top: 10rpx;
}

.q-acts {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.act {
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  color: #F3F7F4;
  background: var(--moss);
}

.act.ghost {
  color: var(--moss);
  background: rgba(56, 97, 79, 0.08);
}

.act-press {
  opacity: 0.72;
}

.act-none {
  font-size: 22rpx;
  color: var(--ink-3);
}

/* ---------- 提醒 ---------- */
.alert-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--line-soft);
}

.alert-list .alert-row:first-child {
  border-top: none;
  padding-top: 4rpx;
}

.alert-main {
  flex: 1;
  min-width: 0;
}

.alert-t {
  font-size: 26rpx;
  color: var(--ink);
}

.alert-h {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

.alert-n {
  font-size: 30rpx;
  color: var(--moss);
  margin-right: 12rpx;
}

.alert-n.alert {
  color: var(--alert);
}

.alert-n.caution {
  color: #8A6C42;
}

.alert-n.note {
  color: var(--note);
}

.alert-arrow {
  font-size: 30rpx;
  color: var(--ink-3);
  line-height: 1;
}

/* ---------- 随访 ---------- */
.fu-row {
  display: flex;
  align-items: baseline;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line-soft);
}

.fu-list .fu-row:first-child {
  border-top: none;
  padding-top: 2rpx;
}

.fu-no {
  flex: none;
  width: 168rpx;
  font-size: 23rpx;
  color: var(--ink-2);
}

.fu-txt {
  flex: 1;
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* ---------- 页脚说明 ---------- */
.disc {
  margin-top: 30rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--ink-3);
}

.scope {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--ink-3);
  opacity: 0.85;
}
