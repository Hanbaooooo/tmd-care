/* ---------- 头部 ---------- */
.head {
  /* 评估组紧跟在问候语下面，这里少留一点，首屏才能露出大圆环 */
  padding: 8rpx 0 30rpx;
}

.head-date {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
}

.head-title {
  font-size: 52rpx;
  line-height: 1.34;
  letter-spacing: 1rpx;
}

.head-sub {
  margin-top: 14rpx;
}

.ml {
  margin-left: 12rpx;
}

.mt6 { margin-top: 6rpx; }
.mt8 { margin-top: 8rpx; }
.mt12 { margin-top: 12rpx; }
.mt16 { margin-top: 16rpx; }
.mt20 { margin-top: 20rpx; }
.mt24 { margin-top: 24rpx; }

/* ---------- 未同步：一行字，不做色块 ---------- */
.sync-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 0 18rpx;
  font-size: 23rpx;
  color: var(--note);
  margin-bottom: 26rpx;
  border-bottom: 1rpx solid var(--line-soft);
  transition: opacity 200ms;
}

.sync-act {
  color: var(--note);
}

/* ---------- 今日锚点：无容器，只靠留白 ---------- */
.anchor {
  padding: 6rpx 0 4rpx;
  margin-bottom: 56rpx;
}

.anchor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.anchor-label {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 4rpx;
}

.anchor-state {
  font-size: 22rpx;
  color: var(--moss);
  letter-spacing: 1rpx;
}

.stage {
  position: relative;
  height: 340rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.halo {
  display: none;
}

.ring {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(56, 97, 79, 0.16);
  box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.9);
}

.core {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 220ms cubic-bezier(0.32, 0.72, 0, 1);
}

.core-num {
  font-size: 108rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--moss);
}

.core-unit {
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
  margin-top: 10rpx;
}

.stage-press .core {
  transform: scale(0.94);
}

.anchor-tail {
  text-align: center;
  font-size: 25rpx;
  color: var(--ink-2);
  margin-top: 4rpx;
}

.ask {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-top: 20rpx;
}

/* ---------- NRS 选择 ---------- */
.nrs-row {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
}

.nrs-cell {
  flex: 1;
  height: 62rpx;
  min-width: 0;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: var(--ink-2);
  transition: background 220ms, color 220ms, border-color 220ms;
}

.nrs-cell.on {
  background: var(--moss);
  border-color: var(--moss);
  color: #F3F7F4;
}

/* ---------- 咬紧觉察 ---------- */
.clench-row {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.clench {
  flex: 1;
  height: 78rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--line);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--ink-2);
  transition: background 220ms, color 220ms, border-color 220ms;
}

.clench.on {
  background: var(--sage-bg);
  border-color: var(--moss);
  color: var(--moss);
}

/* ---------- 主任务 ---------- */
.primary-task {
  padding-bottom: 36rpx;
  margin-bottom: 34rpx;
}

.task-cta {
  margin-top: 26rpx;
  font-size: 26rpx;
  color: var(--moss);
  transition: opacity 200ms;
}

.small {
  font-size: 30rpx;
}

/* ---------- 最近记录 ---------- */
.record-row {
  margin-top: 6rpx;
  padding: 24rpx 0 22rpx;
}

.record-date {
  font-size: 26rpx;
  color: var(--ink-2);
  letter-spacing: 1rpx;
}

.record-nrs {
  font-size: 34rpx;
}

.record-nrs.calm {
  color: var(--moss);
}

.record-nrs.caution {
  color: var(--note);
}

.record-nrs.danger {
  color: var(--alert);
}

/* ---------- 快捷入口：三列纯文字，用竖线分隔 ---------- */
.quick-grid {
  display: flex;
  gap: 0;
  margin-top: 22rpx;
  border-top: 1rpx solid var(--line-soft);
}

.quick {
  flex: 1;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 24rpx 0 6rpx;
  text-align: left;
  transition: opacity 200ms;
}

.quick + .quick {
  padding-left: 22rpx;
  margin-left: 22rpx;
  border-left: 1rpx solid var(--line-soft);
}

.quick-title {
  font-size: 27rpx;
  color: var(--ink);
  margin-bottom: 6rpx;
}

/* ---------- 每周复查：不套卡，上下各一条细线 ---------- */
.week-card {
  margin-top: 4rpx;
  padding: 26rpx 0 28rpx;
  border-top: 1rpx solid var(--line-soft);
  border-bottom: 1rpx solid var(--line-soft);
  transition: opacity 200ms;
}

.week-card.is-due {
  border-top-color: var(--sage);
}

.week-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.week-label {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

.week-state {
  font-size: 22rpx;
  color: var(--ink-3);
}

.week-state.due {
  color: var(--moss);
}

.week-title {
  margin-top: 16rpx;
  font-size: 33rpx;
  line-height: 1.46;
  color: var(--ink);
}

.week-dot {
  color: var(--ink-3);
  margin: 0 10rpx;
}

.week-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.week-note {
  font-size: 23rpx;
  color: var(--ink-3);
  flex: 1;
}

.week-go {
  font-size: 25rpx;
  color: var(--moss);
  margin-left: 20rpx;
}

/* ---------- 六周计划：只留一行位置，不复制标题与摘要 ---------- */
.plan-line {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line-soft);
  transition: opacity 200ms;
}

.plan-line-label {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: var(--ink-3);
}

.plan-line-state {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  font-size: 25rpx;
  color: var(--ink-2);
}

/* ---------- 周提醒 ---------- */
.remind-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0 6rpx;
}

.remind-text {
  flex: 1;
  padding-right: 24rpx;
}

.remind-title {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 4rpx;
}

.remind-row switch {
  transform: scale(0.78);
  transform-origin: right center;
}

/* ---------- 评估：两行并成一组，置顶常驻 ---------- */
.eval-group {
  margin: 0 0 44rpx;
}

.eval-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.eval-label {
  font-size: 21rpx;
  letter-spacing: 5rpx;
  color: var(--ink-2);
}

.eval-hint {
  font-size: 21rpx;
  color: var(--ink-3);
}

/* 置顶时最后一行收掉下边线，靠留白收尾 */
.eval-group .entry-line:last-child {
  border-bottom: none;
}

.entry-main {
  flex: 1 1 auto;
  min-width: 0;
}

/* 第一行略重：它是主入口 */
.entry-line.is-key .entry-title {
  font-size: 31rpx;
}

/* 没有副说明时，标题不要留空档 */
.entry-line .entry-title:last-child {
  margin-bottom: 0;
}

/* ---------- 列表入口 ---------- */
.entry-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 26rpx 0;
  margin-top: 0;
  border-bottom: 1rpx solid var(--line-soft);
  transition: opacity 200ms;
}

.entry-title {
  font-size: 29rpx;
  color: var(--ink);
  margin-bottom: 6rpx;
}

.entry-arrow {
  font-size: 30rpx;
  color: var(--ink-3);
  margin-left: 20rpx;
}

.foot {
  margin-top: 52rpx;
  line-height: 1.8;
}

/* ---------- 本次就诊 ---------- */
.visit {
  margin: 6rpx 0 10rpx;
  padding: 24rpx 26rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
}

/* 未绑定用虚线：一眼看出这一格还没成立 */
.visit-empty {
  background: rgba(255, 255, 255, 0.3);
  border-style: dashed;
  border-color: rgba(30, 47, 41, 0.16);
}

.visit-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.visit-label {
  font-size: 23rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.visit-badge {
  font-size: 21rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  color: var(--note);
  background: var(--note-bg);
}

.visit-badge.caution {
  color: #8A6C42;
  background: rgba(192, 161, 112, 0.18);
}

.visit-badge.calm {
  color: var(--moss);
  background: var(--sage-bg);
}

.visit-no {
  margin-top: 12rpx;
  font-size: 36rpx;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.visit-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.visit-act {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--moss);
}

.visit-arrow {
  font-size: 28rpx;
  color: var(--moss-soft);
}
