/* 医师工作台详情：共用版式 + 表单控件 */

@import "/styles/report-common.wxss";

.mb16 {
  margin-bottom: 16rpx;
}
.mt6 {
  margin-top: 6rpx;
}

.state-tag {
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 0.6rpx;
}

/* ---------- 分组 ---------- */
.group {
  margin-top: 26rpx;
}

.group-head {
  display: flex;
  align-items: baseline;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid var(--line-soft);
  margin-bottom: 4rpx;
}

.group-title {
  font-size: 26rpx;
  color: var(--ink);
  letter-spacing: 0.6rpx;
}

.group-hint {
  flex: 1;
  text-align: right;
  font-size: 21rpx;
  color: var(--ink-3);
  margin-left: 16rpx;
}

/* ---------- 字段 ---------- */
.field {
  padding: 18rpx 0 6rpx;
}

.field-label {
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}

.req {
  font-size: 19rpx;
  color: var(--alert);
  margin-left: 10rpx;
  letter-spacing: 0.5rpx;
}

.unit {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-left: 8rpx;
}

/* 多选部位 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 12rpx 20rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
}

.chip.on {
  color: #F3F7F4;
  background: var(--moss);
  border-color: var(--moss);
}

/* 「无」用虚线：和具体部位区分开，不能一眼看成同类选项 */
.chip-none {
  border-style: dashed;
  border-color: rgba(30, 47, 41, 0.2);
  color: var(--ink-3);
}

.chip-none.on {
  color: #F3F7F4;
  background: var(--ink-2);
  border-color: var(--ink-2);
  border-style: solid;
}

.chip-press {
  opacity: 0.72;
}

/* 单选 */
.opts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.opt {
  padding: 12rpx 22rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  background: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
}

.opt.on {
  color: var(--moss);
  background: var(--sage-bg);
  border-color: var(--sage);
}

/* 输入 */
.num-input,
.text-input {
  height: 76rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
}

.num-input {
  width: 220rpx;
}

.note-input {
  width: 100%;
  min-height: 180rpx;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 10rpx;
  box-sizing: border-box;
}

/* ---------- 操作 ---------- */
.actions {
  margin-top: 56rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--line-soft);
}
