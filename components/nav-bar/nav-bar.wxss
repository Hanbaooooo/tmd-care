.nav-holder {
  width: 100%;
}

.nav-glass {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(
    180deg,
    rgba(252, 254, 253, 0.8) 0%,
    rgba(252, 254, 253, 0.5) 56%,
    rgba(252, 254, 253, 0) 100%
  );
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%);
  mask-image: linear-gradient(180deg, #000 0%, #000 62%, transparent 100%);
  pointer-events: none;
}

.nav-back {
  position: fixed;
  left: 10rpx;
  z-index: 101;
  width: 76rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 160ms;
}

.nav-back-on {
  opacity: 0.4;
}

.nav-arrow {
  font-size: 46rpx;
  line-height: 1;
  color: #4F635A;
  margin-top: -2rpx;
}

.nav-title {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 101;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: #4F635A;
  pointer-events: none;
}
