<bg-layer />
<view class="page">
  <nav-bar back="{{true}}" />
  <view class="week-head">
    <view class="tiny">第 {{week.week}} 周</view>
    <view class="h1 mt8">{{week.title}}</view>
    <view class="muted mt12">{{week.summary}}</view>
  </view>

  <!-- 1 学习 -->
  <view class="block">
    <view class="block-head">
      <text class="step-no {{learnDone ? 'done' : ''}}">1</text>
      <text class="block-title">学一段</text>
      <text wx:if="{{learnDone}}" class="tag ml">已读</text>
    </view>
    <view class="card">
      <view wx:for="{{week.learn.points}}" wx:key="*this" class="point">{{item}}</view>
      <view class="divider"></view>
      <view class="tiny">{{week.learn.evidence}}</view>
    </view>
    <view wx:if="{{!learnDone}}" class="btn-ghost" bindtap="markLearn" hover-class="is-active" hover-stay-time="80">我已读完这一段</view>
  </view>

  <!-- 2 练习 -->
  <view class="block">
    <view class="block-head">
      <text class="step-no {{practiceDone ? 'done' : ''}}">2</text>
      <text class="block-title">{{week.practice.name}}</text>
      <text class="tiny ml">{{week.practice.minutes}} 分钟</text>
    </view>
    <view class="card">
      <view wx:for="{{week.practice.steps}}" wx:key="*this" class="step-line">
        <text class="step-index">{{index + 1}}</text>
        <text class="step-text">{{item}}</text>
      </view>
    </view>
    <view class="btn-primary {{practiceDone ? 'is-active' : ''}}" bindtap="doPractice" hover-class="is-active" hover-stay-time="80">
      {{practiceDone ? '再练一次' : '现在做一次'}}
    </view>
    <view wx:if="{{practiceDone}}" class="tiny mt10">本周练了 {{practiceCount}} 次。短练习随时能重复用，但代替不了本周的课程记录。</view>
  </view>

  <!-- 3 在生活中尝试 -->
  <view class="block">
    <view class="block-head">
      <text class="step-no">3</text>
      <text class="block-title">在生活中试一次</text>
    </view>
    <view class="card">
      <view class="body">{{week.life.task}}</view>
      <view class="divider"></view>
      <view wx:for="{{week.life.tips}}" wx:key="*this" class="tiny tip-line">{{item}}</view>
    </view>
    <view class="tiny mt10">这一步不用打卡。真的做到一次，比在这里点一下有用。</view>
  </view>

  <!-- 4 周末回顾 -->
  <view class="block">
    <view class="block-head">
      <text class="step-no {{reviewDone ? 'done' : ''}}">4</text>
      <text class="block-title">周末回顾</text>
      <text wx:if="{{reviewDone}}" class="tag ml">已完成</text>
    </view>
    <view class="card">
      <view wx:for="{{week.review.prompts}}" wx:key="*this" class="point">{{item}}</view>
      <textarea
        class="textarea"
        placeholder="随便写几句就好，不用写完整"
        value="{{reflection}}"
        bindinput="onReflection"
        maxlength="500"
        auto-height
      />
    </view>
    <view class="btn-primary {{saving ? 'is-disabled' : ''}}" bindtap="saveReview" hover-class="is-active" hover-stay-time="80">
      {{saving ? '正在保存…' : (reviewDone ? '更新回顾' : '完成本周')}}
    </view>
    <view wx:if="{{!signedIn}}" class="tiny mt10">未登录，回顾只会存在这台手机上。</view>
    <view wx:if="{{reviewDone && week.week < 6}}" class="btn-ghost mt16" bindtap="nextWeek" hover-class="is-active" hover-stay-time="80">
      本周完成，去第 {{week.week + 1}} 周 ›
    </view>
    <view wx:if="{{reviewDone && week.week === 6}}" class="tiny mt10">六周走完了。回到六周计划，把最有效的部分留成每周的习惯。</view>
  </view>

  <!-- 此刻需要帮助：疼起来就能用，点开是完整步骤 -->
  <view class="block">
    <view class="block-head">
      <text class="block-title">此刻需要帮助</text>
      <text class="tiny ml">{{week.quick.minutes}} 分钟</text>
    </view>
    <view class="card-flat" bindtap="toggleQuick" hover-class="tap-dim" hover-stay-time="80">
      <view class="row">
        <view class="body">{{week.quick.name}}</view>
        <text class="tiny">{{quickOpen ? '收起' : '看步骤'}}</text>
      </view>
      <block wx:if="{{quickOpen}}">
        <view class="divider"></view>
        <view wx:for="{{week.quick.steps}}" wx:key="*this" class="step-line">
          <text class="step-index">{{index + 1}}</text>
          <text class="step-text">{{item}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="nav-row">
    <view class="btn-ghost flex1 {{week.week === 1 ? 'is-hidden' : ''}}" bindtap="prevWeek" hover-class="is-active" hover-stay-time="80">上一周</view>
    <view class="btn-ghost flex1 {{week.week === 6 ? 'is-hidden' : ''}}" bindtap="nextWeek" hover-class="is-active" hover-stay-time="80">下一周</view>
  </view>
</view>
